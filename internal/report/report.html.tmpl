<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.T.Titolo}} — {{.Sys.Manufacturer}} {{.Sys.Model}}</title>
<style>
  :root {
    --ink: #17181c;
    --muted: #6b6f76;
    --line: #dcdfe4;
    --bg: #ffffff;
    --critical: #b3261e;
    --critical-bg: #fdeceb;
    --warn: #8a5a00;
    --warn-bg: #fdf3e2;
    --info: #1a5f8a;
    --info-bg: #eaf3f9;
    --ok: #1e6b3a;
    --ok-bg: #ebf5ee;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 32px 24px; background: #f4f5f7; color: var(--ink);
    font: 15px/1.55 -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  .foglio {
    max-width: 820px; margin: 0 auto; background: var(--bg);
    border: 1px solid var(--line); border-radius: 6px; padding: 40px;
  }
  header { display: flex; justify-content: space-between; align-items: flex-start;
           gap: 24px; border-bottom: 2px solid var(--ink); padding-bottom: 16px; }
  h1 { font-size: 22px; margin: 0 0 4px; letter-spacing: -0.01em; }
  .sottotitolo { color: var(--muted); font-size: 13px; }
  .tecnico { text-align: right; font-size: 13px; line-height: 1.5; }
  .tecnico strong { display: block; font-size: 15px; }

  .scheda { display: grid; grid-template-columns: repeat(2, 1fr);
            gap: 4px 32px; margin: 24px 0; font-size: 14px; }
  .scheda div { display: flex; justify-content: space-between; gap: 12px;
                padding: 5px 0; border-bottom: 1px dotted var(--line); }
  .scheda dt { color: var(--muted); }
  .scheda dd { margin: 0; text-align: right; font-weight: 500; }

  .esito { padding: 14px 18px; border-radius: 5px; margin: 28px 0 8px;
           border-left: 5px solid; }
  .esito .etichetta { font-weight: 700; letter-spacing: 0.04em; font-size: 13px; }
  .esito .frase { font-size: 17px; font-weight: 600; margin-top: 2px; }
  .esito.critical { background: var(--critical-bg); border-color: var(--critical); color: var(--critical); }
  .esito.warn     { background: var(--warn-bg);     border-color: var(--warn);     color: var(--warn); }
  .esito.info     { background: var(--info-bg);     border-color: var(--info);     color: var(--info); }
  .esito.ok       { background: var(--ok-bg);       border-color: var(--ok);       color: var(--ok); }

  h2 { font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em;
       color: var(--muted); margin: 32px 0 12px; }

  .verdetto { border: 1px solid var(--line); border-left: 4px solid;
              border-radius: 5px; padding: 16px 18px; margin-bottom: 14px;
              page-break-inside: avoid; }
  .verdetto.critical { border-left-color: var(--critical); }
  .verdetto.warn     { border-left-color: var(--warn); }
  .verdetto.info     { border-left-color: var(--info); }
  .intestazione { display: flex; align-items: center; gap: 10px;
                  margin-bottom: 6px; flex-wrap: wrap; }
  .badge { font-size: 11px; font-weight: 700; letter-spacing: 0.05em;
           padding: 3px 8px; border-radius: 3px; }
  .badge.critical { background: var(--critical); color: #fff; }
  .badge.warn     { background: var(--warn);     color: #fff; }
  .badge.info     { background: var(--info);     color: #fff; }
  .dove { color: var(--muted); font-size: 12px; }
  .titolo { font-weight: 650; font-size: 15px; margin-bottom: 6px; }
  .dettaglio { color: #34373d; font-size: 14px; }
  .azione { margin-top: 10px; padding: 10px 12px; background: #f7f8f9;
            border-radius: 4px; font-size: 14px; }
  .azione::before { content: attr(data-label) " — "; font-weight: 700; }
  .dati { margin-top: 8px; font-size: 11px; color: var(--muted);
          font-family: ui-monospace, "Cascadia Mono", Consolas, monospace;
          word-break: break-all; }

  table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
  th { text-align: left; font-weight: 600; color: var(--muted); font-size: 12px;
       text-transform: uppercase; letter-spacing: 0.04em;
       border-bottom: 1px solid var(--line); padding: 6px 8px; }
  td { padding: 7px 8px; border-bottom: 1px solid #eef0f2; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; }
  tr.evidenza td { color: var(--critical); font-weight: 600; }
  .sistema { font-size: 11px; color: var(--info); font-weight: 700; }

  .nota { margin-top: 28px; padding: 12px 14px; background: var(--info-bg);
          border-radius: 5px; font-size: 13px; color: var(--info); }
  footer { margin-top: 32px; padding-top: 14px; border-top: 1px solid var(--line);
           color: var(--muted); font-size: 12px;
           display: flex; justify-content: space-between; gap: 16px; }

  @media print {
    body { background: #fff; padding: 0; font-size: 11pt; }
    .foglio { border: 0; border-radius: 0; padding: 0; max-width: none; }
    .verdetto, tr { page-break-inside: avoid; }
    h2 { page-break-after: avoid; }
  }
</style>
</head>
<body>
<div class="foglio">

  <header>
    <div>
      <h1>{{.T.Titolo}}</h1>
      <div class="sottotitolo">
        {{.T.Sottotitolo}} {{.Data}}{{if .Opts.Customer}} · {{.T.Cliente}}: {{.Opts.Customer}}{{end}}
      </div>
    </div>
    {{if .Opts.Technician}}
    <div class="tecnico">
      <strong>{{.Opts.Technician}}</strong>
      {{if .Opts.Contact}}{{.Opts.Contact}}{{end}}
    </div>
    {{end}}
  </header>

  <dl class="scheda">
    <div><dt>{{$.T.Produttore}}</dt><dd>{{.Sys.Manufacturer}}</dd></div>
    <div><dt>{{$.T.Modello}}</dt><dd>{{.Sys.Model}}</dd></div>
    <div><dt>{{$.T.Tipo}}</dt><dd>{{.Sys.Chassis}}</dd></div>
    <div><dt>{{$.T.Processore}}</dt><dd>{{.Sys.CPU}}</dd></div>
    <div><dt>{{$.T.CoreThread}}</dt><dd>{{.Sys.Cores}} / {{.Sys.Threads}}</dd></div>
    <div><dt>{{$.T.Memoria}}</dt><dd>{{.RAM}}</dd></div>
    <div><dt>{{$.T.SistemaOperativo}}</dt><dd>{{.Sys.OS}}</dd></div>
    <div><dt>{{$.T.Ver}}</dt><dd>{{.Sys.OSVersion}}</dd></div>
  </dl>

  <div class="esito {{.EsitoCSS}}">
    <div class="etichetta">{{.T.Esito}}</div>
    <div class="frase">{{.Esito}} — {{.Riepilogo}}</div>
  </div>

  {{if .Findings}}
  <h2>{{.T.Rilevato}}</h2>
  {{range .Findings}}
  <div class="verdetto {{.CSS}}">
    <div class="intestazione">
      <span class="badge {{.CSS}}">{{.Severita}}</span>
      <span class="dove">{{.Area}} · {{.Target}}</span>
    </div>
    <div class="titolo">{{.Titolo}}</div>
    <div class="dettaglio">{{.Dettaglio}}</div>
    <div class="azione" data-label="{{$.T.CosaFare}}">{{.Azione}}</div>
    {{if .Dati}}<div class="dati">{{.Dati}}</div>{{end}}
  </div>
  {{end}}
  {{end}}

  <h2>{{.T.Dischi}}</h2>
  <table>
    <thead><tr>
      <th>{{.T.ColTipo}}</th><th>{{.T.ColModello}}</th><th class="num">{{.T.ColCapacita}}</th>
      <th>{{.T.ColBus}}</th><th>{{.T.ColStato}}</th><th class="num">{{.T.ColTemp}}</th>
      <th class="num">{{.T.ColVita}}</th><th class="num">{{.T.ColScritti}}</th>
    </tr></thead>
    <tbody>
    {{range .Disks}}
      <tr>
        <td>{{.Tipo}}</td>
        <td>{{.Modello}}{{if .DiSistema}} <span class="sistema">{{$.T.Sistema}}</span>{{end}}</td>
        <td class="num">{{.Capacita}}</td>
        <td>{{.Bus}}</td>
        <td>{{.Stato}}</td>
        <td class="num">{{.Temp}}</td>
        <td class="num">{{.Vita}}</td>
        <td class="num">{{.Scritti}}</td>
      </tr>
    {{end}}
    </tbody>
  </table>

  <h2>{{.T.Volumi}}</h2>
  <table>
    <thead><tr>
      <th>{{.T.ColUnita}}</th><th>{{.T.ColFS}}</th><th class="num">{{.T.ColCapacita}}</th>
      <th class="num">{{.T.ColLibero}}</th><th class="num">%</th><th>{{.T.ColStato}}</th>
    </tr></thead>
    <tbody>
    {{range .Volumes}}
      <tr {{if .Critico}}class="evidenza"{{end}}>
        <td>{{.Lettera}}:</td>
        <td>{{.FS}}</td>
        <td class="num">{{.Capacita}}</td>
        <td class="num">{{.Libero}}</td>
        <td class="num">{{.Percento}}</td>
        <td>{{.Stato}}</td>
      </tr>
    {{end}}
    </tbody>
  </table>

  {{if not .Elevated}}
  <div class="nota">
    <strong>{{.T.NotaTitolo}}</strong> {{.T.NotaTesto}}
  </div>
  {{end}}

  <footer>
    <span>{{.T.Generato}} {{.Version}}</span>
    <span>{{.Data}}</span>
  </footer>

</div>
</body>
</html>
