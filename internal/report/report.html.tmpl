<!doctype html>
<html lang="{{.Lang}}" data-theme="dark">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="dark light"><title>diskseer — {{.T.Titolo}}</title>
<style>
.disk-status.critical{color:var(--critical)}.disk-status.warn{color:var(--warn)}.disk-status.info{color:var(--info)}.disk-status.ok{color:var(--ok)}
:root{--bg:#090b11;--panel:#111520;--panel2:#171c29;--ink:#f5f7fb;--muted:#929bab;--line:#252c3b;--brand:#7768ff;--aqua:#42ddc9;--critical:#ff6b6b;--warn:#ffbd59;--info:#65baff;--ok:#50db8b;--shadow:0 20px 55px #0005;color-scheme:dark}
[data-theme=light]{--bg:#eef1f7;--panel:#fff;--panel2:#f6f7fb;--ink:#171a24;--muted:#667084;--line:#dfe3ec;--shadow:0 18px 45px #23304a18;color-scheme:light}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(circle at 10% -10%,#7768ff25,transparent 30rem),var(--bg);color:var(--ink);font:15px/1.55 Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.shell{display:grid;grid-template-columns:240px minmax(0,1fr);min-height:100vh}.side{position:sticky;top:0;height:100vh;padding:28px 22px;border-right:1px solid var(--line);background:#090b11d9;backdrop-filter:blur(18px)}[data-theme=light] .side{background:#ffffffe8}.brand{display:flex;gap:12px;align-items:center;margin-bottom:42px}.brand .mark{width:42px;height:42px;border-radius:11px;flex:0 0 auto}.brand strong{display:block;font-size:19px;letter-spacing:-.04em}.brand small{display:block;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.12em}.nav a{display:flex;align-items:center;gap:10px;color:var(--muted);text-decoration:none;padding:11px 12px;border-radius:10px;margin:3px 0;font-weight:600}.nav a:hover,.nav a:first-child{color:var(--ink);background:var(--panel2)}.dot{width:7px;height:7px;border-radius:50%;background:var(--brand)}.side-foot{position:absolute;bottom:25px;color:var(--muted);font-size:11px}.vivo{display:inline-flex;align-items:center;gap:6px;color:var(--ok);font-weight:800;letter-spacing:.08em;--tone:var(--ok);margin-bottom:6px}.vivo .pulse{animation:respira 1.6s ease-in-out infinite}@keyframes respira{50%{opacity:.25}}.main{width:100%;max-width:1220px;padding:34px 42px 70px;margin:auto}.topbar{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:32px}.eyebrow{color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.12em}.topbar h1{font-size:28px;line-height:1.15;margin:4px 0;letter-spacing:-.04em}.actions{display:flex;gap:9px}.btn{border:1px solid var(--line);background:var(--panel);color:var(--ink);border-radius:10px;padding:9px 13px;cursor:pointer;font:inherit;font-weight:650}.btn:hover{border-color:var(--brand);transform:translateY(-1px)}.hero{position:relative;overflow:hidden;display:grid;grid-template-columns:1fr auto;align-items:center;gap:20px;background:linear-gradient(125deg,var(--panel),var(--panel2));border:1px solid var(--line);border-radius:22px;padding:28px 30px;box-shadow:var(--shadow)}.hero:after{content:"";position:absolute;right:-70px;top:-100px;width:260px;height:260px;border-radius:50%;background:var(--tone);opacity:.09;filter:blur(3px)}.hero.critical{--tone:var(--critical)}.hero.warn{--tone:var(--warn)}.hero.info{--tone:var(--info)}.hero.ok{--tone:var(--ok)}.status{display:flex;align-items:center;gap:10px;color:var(--tone);font-size:12px;font-weight:800;letter-spacing:.11em}.pulse{width:9px;height:9px;border-radius:50%;background:var(--tone);box-shadow:0 0 0 6px color-mix(in srgb,var(--tone) 18%,transparent)}.result{font-size:30px;font-weight:760;letter-spacing:-.035em;margin:9px 0 4px}.summary{color:var(--muted)}.score{position:relative;z-index:1;display:grid;place-items:center;width:106px;height:106px;border-radius:50%;border:8px solid color-mix(in srgb,var(--tone) 25%,var(--line));color:var(--tone);font-weight:800;font-size:17px}.grid-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:18px 0 34px}.stat{padding:18px 20px;background:var(--panel);border:1px solid var(--line);border-radius:15px}.stat b{font-size:25px}.stat span{display:block;color:var(--muted);font-size:12px}.stat.critical b{color:var(--critical)}.stat.warn b{color:var(--warn)}.stat.info b{color:var(--info)}.section-head{display:flex;justify-content:space-between;align-items:end;gap:16px;margin:34px 0 14px}.section-head h2{font-size:19px;margin:0;letter-spacing:-.02em}.section-head p{margin:2px 0 0;color:var(--muted);font-size:12px}.filters{display:flex;gap:6px}.filter{border:1px solid var(--line);background:transparent;color:var(--muted);padding:6px 10px;border-radius:999px;cursor:pointer;font:inherit;font-size:12px}.filter.active{background:var(--ink);color:var(--bg);border-color:var(--ink)}.finding{display:grid;grid-template-columns:8px 1fr;overflow:hidden;background:var(--panel);border:1px solid var(--line);border-radius:15px;margin:10px 0;transition:.2s}.finding[hidden]{display:none}.finding:hover{transform:translateY(-2px);box-shadow:var(--shadow)}.rail{background:var(--tone)}.finding.critical{--tone:var(--critical)}.finding.warn{--tone:var(--warn)}.finding.info{--tone:var(--info)}.finding-body{padding:19px 21px}.finding-top{display:flex;gap:9px;align-items:center;flex-wrap:wrap}.badge{color:var(--tone);background:color-mix(in srgb,var(--tone) 14%,transparent);padding:3px 8px;border-radius:6px;font-size:10px;font-weight:850;letter-spacing:.08em}.where{color:var(--muted);font-size:12px}.finding h3{margin:9px 0 5px;font-size:16px}.detail{color:var(--muted)}.action{margin-top:13px;background:var(--panel2);padding:11px 13px;border-radius:9px}.action b{color:var(--aqua)}details{margin-top:8px;color:var(--muted);font:11px ui-monospace,monospace}details summary{cursor:pointer}.empty{padding:25px;border:1px dashed var(--line);border-radius:14px;color:var(--ok);text-align:center}.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}.card{background:var(--panel);border:1px solid var(--line);border-radius:15px;padding:18px}.card-title{display:flex;justify-content:space-between;gap:14px}.card h3{font-size:15px;margin:0}.tag{color:var(--aqua);font-size:10px;font-weight:800}.meta{display:flex;flex-wrap:wrap;gap:14px;color:var(--muted);font-size:12px;margin-top:12px}.volumes{background:var(--panel);border:1px solid var(--line);border-radius:15px;overflow:hidden}.volume{display:grid;grid-template-columns:65px 1fr 130px 95px;align-items:center;gap:16px;padding:15px 18px;border-bottom:1px solid var(--line)}.volume:last-child{border:0}.drive{font-size:17px;font-weight:800}.bar{height:7px;background:var(--panel2);border-radius:8px;overflow:hidden;margin-top:6px}.bar i{display:block;height:100%;width:calc(var(--used)*1%);background:linear-gradient(90deg,var(--brand),var(--aqua));border-radius:8px}.volume.critical .bar i{background:var(--critical)}.num{text-align:right;font-variant-numeric:tabular-nums}.muted{color:var(--muted);font-size:12px}.notice{margin:22px 0;padding:14px 16px;border-radius:12px;background:color-mix(in srgb,var(--info) 10%,var(--panel));border:1px solid color-mix(in srgb,var(--info) 35%,var(--line));color:var(--info)}.system-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:15px;overflow:hidden}.datum{background:var(--panel);padding:14px}.datum small{display:block;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.06em}.datum strong{display:block;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}footer{margin-top:35px;display:flex;justify-content:space-between;color:var(--muted);font-size:11px}
@media(max-width:850px){.shell{display:block}.side{position:static;height:auto;padding:17px 20px;border-right:0;border-bottom:1px solid var(--line)}.brand{margin:0}.nav,.side-foot{display:none}.main{padding:24px 18px}.cards{grid-template-columns:1fr}.system-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.topbar{align-items:flex-start}.topbar h1{font-size:23px}.btn span{display:none}.hero{grid-template-columns:1fr}.score{display:none}.grid-stats{gap:7px}.stat{padding:13px}.volume{grid-template-columns:50px 1fr}.volume>.num{display:none}.section-head{align-items:flex-start;flex-direction:column}.filters{overflow:auto;max-width:100%}}@media print{.side,.actions,.filters{display:none}.shell{display:block}.main{padding:0;max-width:none}.finding,.card,.hero{break-inside:avoid;box-shadow:none}body{background:#fff}.hero{margin-top:0}}
@media print{:root{--bg:#fff;--panel:#fff;--panel2:#f3f4f6;--ink:#111;--muted:#444;--line:#ccc;color-scheme:light}.finding[hidden]{display:grid}.volume>.num{display:block}.volume{grid-template-columns:65px 1fr 130px 95px}}
</style>
<link rel="icon" type="image/png" href="{{.Logo}}">
</head>
<body><div class="shell">
<aside class="side"><div class="brand">
<img class="mark" src="{{.Logo}}" alt="" width="42" height="42">
<div><strong>diskseer</strong><small>{{.T.Analisi}}</small></div></div><nav class="nav"><a href="#overview"><i class="dot"></i>{{.T.Panoramica}}</a><a href="#findings"><i class="dot"></i>{{.T.Problemi}}</a><a href="#drives"><i class="dot"></i>{{.T.Dischi}}</a><a href="#volumes"><i class="dot"></i>{{.T.Volumi}}</a></nav><div class="side-foot">{{if .RicaricaOgni}}<span class="vivo"><i class="pulse"></i>LIVE · {{.RicaricaOgni}}s</span><br>{{end}}v{{.Version}} · offline &amp; private</div></aside>
<main class="main"><header class="topbar"><div><div class="eyebrow">{{.T.Sottotitolo}} {{.Data}}</div><h1>{{.Sys.Manufacturer}} {{.Sys.Model}}</h1>{{if .Opts.Customer}}<div class="muted">{{.T.Cliente}} · {{.Opts.Customer}}</div>{{end}}</div><div class="actions"><button class="btn" id="theme" title="{{.T.Tema}}">◐</button><button class="btn" onclick="print()">⌁ <span>{{.T.Stampa}}</span></button></div></header>
<section id="overview"><div class="hero {{.EsitoCSS}}"><div><div class="status"><i class="pulse"></i>{{.T.Esito}}</div><div class="result">{{.Esito}}</div><div class="summary">{{.Riepilogo}}</div></div><div class="score">{{.Esito}}</div></div><div class="grid-stats"><div class="stat critical"><b>{{.Criticals}}</b><span>{{.T.Critici}}</span></div><div class="stat warn"><b>{{.Warnings}}</b><span>{{.T.Avvisi}}</span></div><div class="stat info"><b>{{.Infos}}</b><span>Info</span></div></div></section>
<section id="findings"><div class="section-head"><div><h2>{{.T.Problemi}}</h2><p>{{.T.Filtra}}</p></div>{{if .Findings}}<div class="filters"><button class="filter active" data-filter="all">{{.T.Tutti}}</button><button class="filter" data-filter="critical">{{.T.Critici}}</button><button class="filter" data-filter="warn">{{.T.Avvisi}}</button><button class="filter" data-filter="info">Info</button></div>{{end}}</div>
{{if .Findings}}{{range .Findings}}<article class="finding {{.CSS}}" data-severity="{{.CSS}}"><i class="rail"></i><div class="finding-body"><div class="finding-top"><span class="badge">{{.Severita}}</span><span class="where">{{.Area}} · {{.Target}}</span></div><h3>{{.Titolo}}</h3><div class="detail">{{.Dettaglio}}</div><div class="action"><b>{{$.T.CosaFare}} — </b>{{.Azione}}</div>{{if .Dati}}<details><summary>{{$.T.Evidenze}}</summary>{{.Dati}}</details>{{end}}</div></article>{{end}}{{else}}<div class="empty">✓ {{.T.NessunProblema}}</div>{{end}}</section>
<section id="drives"><div class="section-head"><div><h2>{{.T.Dischi}}</h2><p>{{len .Disks}} {{.T.Dischi}}</p></div></div><div class="cards">{{range .Disks}}<article class="card"><div class="card-title"><div><h3>{{.Modello}}</h3><span class="muted">{{.Tipo}} · {{.Capacita}}</span></div>{{if .DiSistema}}<span class="tag">{{$.T.Sistema}}</span>{{end}}</div><div class="meta"><span>{{$.T.ColBus}} <b>{{.Bus}}</b></span><span>{{$.T.ColStato}} <b class="disk-status {{.StatoCSS}}">{{.Stato}}</b></span>{{if .Windows}}<span>{{$.T.StatoWindows}} <b>{{.Windows}}</b></span>{{end}}<span>{{$.T.ColTemp}} <b>{{.Temp}}</b></span><span>{{$.T.ColVita}} <b>{{.Vita}}</b></span><span>{{$.T.ColScritti}} <b>{{.Scritti}}</b></span></div></article>{{end}}</div></section>
<section id="volumes"><div class="section-head"><div><h2>{{.T.Volumi}}</h2><p>{{len .Volumes}} {{.T.Volumi}}</p></div></div><div class="volumes">{{range .Volumes}}<div class="volume {{if .Critico}}critical{{end}}"><div class="drive">{{.Lettera}}:</div><div><b>{{.FS}}</b><div class="bar"><i style="--used:{{.UsedPct}}"></i></div></div><div class="num"><b>{{.Libero}}</b><div class="muted">{{$.T.ColLibero}}</div></div><div class="num"><b>{{.Percento}}</b><div class="muted">{{.Stato}}</div></div></div>{{end}}</div></section>
{{if not .Elevated}}<div class="notice"><b>{{.T.NotaTitolo}}</b> {{.T.NotaTesto}}</div>{{end}}
<section><div class="section-head"><h2>{{.T.SistemaOperativo}}</h2></div><div class="system-grid"><div class="datum"><small>{{.T.Produttore}}</small><strong>{{.Sys.Manufacturer}}</strong></div><div class="datum"><small>{{.T.Modello}}</small><strong>{{.Sys.Model}}</strong></div><div class="datum"><small>{{.T.Processore}}</small><strong title="{{.Sys.CPU}}">{{.Sys.CPU}}</strong></div><div class="datum"><small>{{.T.CoreThread}}</small><strong>{{.Sys.Cores}} / {{.Sys.Threads}}</strong></div><div class="datum"><small>{{.T.Memoria}}</small><strong>{{.RAM}}</strong></div><div class="datum"><small>{{.T.Tipo}}</small><strong>{{.Sys.Chassis}}</strong></div><div class="datum"><small>{{.T.SistemaOperativo}}</small><strong>{{.Sys.OS}}</strong></div><div class="datum"><small>{{.T.Ver}}</small><strong>{{.Sys.OSVersion}}</strong></div></div></section>
<footer><span>{{.T.Generato}} {{.Version}}</span>{{if .Opts.Technician}}<span>{{.Opts.Technician}} · {{.Opts.Contact}}</span>{{end}}<span>{{.Data}}</span></footer></main></div>
<script>
(()=>{
  // Storage can be denied for local files or by browser privacy settings.
  // Theme, filters and refresh must still work in that case.
  const read=(store,key)=>{try{return window[store].getItem(key)}catch{return null}};
  const write=(store,key,value)=>{try{window[store].setItem(key,value)}catch{}};
  const root=document.documentElement,t=document.getElementById('theme');
  const theme=read('localStorage','diskseer-theme');
  if(theme==='light'||theme==='dark')root.dataset.theme=theme;
  t.addEventListener('click',()=>{
    root.dataset.theme=root.dataset.theme==='dark'?'light':'dark';
    write('localStorage','diskseer-theme',root.dataset.theme);
  });
  const filters=Array.from(document.querySelectorAll('.filter'));
  const key='diskseer-filter:'+location.pathname;
  const apply=value=>{
    if(!filters.some(b=>b.dataset.filter===value))value='all';
    filters.forEach(b=>{
      const active=b.dataset.filter===value;
      b.classList.toggle('active',active);
      b.setAttribute('aria-pressed',String(active));
    });
    document.querySelectorAll('.finding').forEach(x=>x.hidden=value!=='all'&&x.dataset.severity!==value);
    write('sessionStorage',key,value);
  };
  filters.forEach(b=>b.addEventListener('click',()=>apply(b.dataset.filter)));
  apply(read('sessionStorage',key)||'all');
})();
</script>
{{if .RicaricaOgni}}<script>
// La pagina si ricarica da sola perché i dati li riscrive diskseer sul file.
//
// Ricaricare azzererebbe la posizione di scorrimento: chi sta guardando la
// terza scheda si ritroverebbe in cima a ogni giro. La si memorizza per la
// durata della scheda del browser e la si rimette appena la pagina torna.
(()=>{
  const chiave='diskseer-scroll:'+location.pathname;
  try {
    const salvata=sessionStorage.getItem(chiave);
    if(salvata!==null){window.scrollTo(0,parseInt(salvata,10)||0);}
  } catch {}
  addEventListener('beforeunload',()=>{try{sessionStorage.setItem(chiave,String(scrollY))}catch{}});
  let timer;
  const schedule=()=>{clearTimeout(timer);timer=setTimeout(()=>location.reload(),{{.RicaricaOgni}}*1000)};
  addEventListener('beforeprint',()=>clearTimeout(timer));
  addEventListener('afterprint',schedule);
  schedule();
})();
</script>{{end}}
</body></html>
